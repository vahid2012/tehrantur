---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  breadcrumbs?: Array<{ name: string; href: string }>;
  relatedArticles?: Array<{ title: string; href: string; description?: string }>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://akay-travel.com/og-default.jpg',
  breadcrumbs = [],
  relatedArticles = [],
  noindex = false,
} = Astro.props;

const siteUrl = 'https://akay-travel.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = title.includes('آکای تراول') ? title : `${title} | آکای تراول`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'آکای تراول',
  alternateName: 'Akay Travel',
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  sameAs: ['https://instagram.com/akay.iran.travel'],
  telephone: '+989143403431',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'شارع آزادكان، شارع تيلا',
    addressLocality: 'أرومية',
    addressRegion: 'أذربيجان الغربية',
    addressCountry: 'IR',
  },
  areaServed: ['SA', 'AE', 'QA', 'KW', 'BH', 'OM'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'آکای تراول',
  alternateName: 'Akay Travel',
  url: siteUrl,
  inLanguage: 'ar',
};

const breadcrumbsSchema =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: new URL(crumb.href, siteUrl).href,
        })),
      }
    : null;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:site_name" content="آکای تراول" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbsSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} />
    )}
  </head>
  <body>
    <slot name="header">
      <slot name="header-content" />
    </slot>

    {breadcrumbs.length > 0 && (
      <div class="bg-ink-100 border-b border-ink-200">
        <div class="max-w-7xl mx-auto px-4 py-3">
          <nav aria-label="مسار التنقل" class="text-sm text-ink-500 flex items-center gap-2 flex-wrap">
            <a href="/" class="hover:text-primary-600 transition-colors">الرئيسية</a>
            {breadcrumbs.map((crumb) => (
              <>
                <span class="text-ink-300">/</span>
                <a href={crumb.href} class="hover:text-primary-600 transition-colors">{crumb.name}</a>
              </>
            ))}
          </nav>
        </div>
      </div>
    )}

    <slot />

    {relatedArticles.length > 0 && (
      <section class="bg-ink-100 py-16">
        <div class="max-w-7xl mx-auto px-4">
          <h2 class="text-2xl font-bold text-ink-800 mb-8 text-center">مقالات ذات صلة</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="bg-white rounded-2xl p-6 card-hover border border-ink-200 block"
              >
                <h3 class="text-lg font-bold text-ink-800 mb-2 hover:text-primary-600 transition-colors">
                  {article.title}
                </h3>
                {article.description && (
                  <p class="text-ink-500 text-sm leading-relaxed">{article.description}</p>
                )}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <slot name="footer" />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
