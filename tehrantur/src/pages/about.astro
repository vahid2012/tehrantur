---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import FloatingInstagram from '../components/FloatingInstagram.astro';
import { images } from '../data/images';

const aboutImg = images['about' as keyof typeof images];

const serviceCards = [
  { title: 'السياحة في إيران', href: '/iran', icon: 'M3.055 13H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { title: 'السياحة العلاجية', href: '/iran/medical-tourism', icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z' },
  { title: 'الاستيراد من إيران', href: '/iran/import', icon: 'M3 7h18M3 12h18M3 17h18' },
  { title: 'الصناعات اليدوية', href: '/iran/handicrafts', icon: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4' },
];

const whyUs = [
  { title: 'ترخيص رسمي', desc: 'مرخصة من منظمة التراث الثقافي والسياحة والصناعات اليدوية في أذربيجان الغربية' },
  { title: 'دعم باللغة العربية', desc: 'فريقنا يتحدث العربية ويقدم دعماً كاملاً للمسافرين من دول الخليج' },
  { title: 'خبرة سنوات', desc: 'سنوات من الخبرة في تنظيم رحلات سياحية وعلاجية وتجارية لإيران' },
  { title: 'خدمات متكاملة', desc: 'من حجز الطيران والإقامة إلى الترجمة والنقل والمتابعة بعد العودة' },
  { title: 'أسعار تنافسية', desc: 'باقات شاملة بأسعار مناسبة توفر jusqu إلى 70% مقارنة بالوجهات الأخرى' },
];

const relatedArticles = [
  { title: 'دليل السياحة في طهران للعرب', href: '/iran/tehran/guide', description: 'دليل شامل لزيارة طهران — المعالم والفنادق والمطاعم.' },
  { title: 'العلاج في إيران للمرضى العرب', href: '/iran/medical-treatment-for-arabs', description: 'كل ما تحتاج معرفته عن العلاج في إيران.' },
  { title: 'حجز تذاكر طيران وفنادق في طهران', href: '/iran/tehran/flight-hotel-booking', description: 'نصائح عملية لحجز الطيران والإقامة في طهران.' },
];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'TravelAgency', 'LocalBusiness'],
  name: 'آکای تراول',
  alternateName: 'Akay Travel',
  url: 'https://akay-travel.com',
  logo: 'https://akay-travel.com/logo.png',
  image: aboutImg?.src,
  sameAs: ['https://instagram.com/akay.iran.travel'],
  telephone: '+989143403431',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'شارع آزادكان، شارع تيلا',
    addressLocality: 'أرومية',
    addressRegion: 'أذربيجان الغربية',
    addressCountry: 'IR',
  },
  areaServed: ['SA', 'AE', 'QA', 'KW', 'BH', 'OM'],
  hasCredential: 'ترخيص رسمي من منظمة التراث الثقافي والسياحة والصناعات اليدوية في أذربيجان الغربية',
};
---

<Base
  title="من نحن | آکای تراول للسياحة العلاجية في إيران"
  description="آکای تراول شركة سياحية مرخصة رسمياً من منظمة التراث الثقافي والسياحة والصناعات اليدوية في أذربيجان الغربية، مقرها أرومية، تخدم المسافرين العرب."
  breadcrumbs={[{ name: 'من نحن', href: '/about' }]}
  relatedArticles={relatedArticles}
  ogImage={aboutImg?.src}
>
  <Header slot="header" />
  <Footer slot="footer" />
  <FloatingWhatsApp />
  <FloatingInstagram />

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <main>
    <section class="relative min-h-[400px] flex items-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src={aboutImg?.src} alt={aboutImg?.alt} class="w-full h-full object-cover" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-l from-ink-900/90 via-ink-900/70 to-ink-900/50"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 py-16 w-full">
        <div class="max-w-2xl">
          <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">من نحن — آکای تراول للسياحة في إيران</h1>
          <p class="text-lg text-ink-200">شركة سياحية مرخصة رسمياً، مقرها أرومية، تخدم المسافرين العرب من دول الخليج.</p>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink-800 mb-6">من هي آکای تراول</h2>
        <div class="prose prose-lg max-w-none text-ink-600 leading-relaxed space-y-4">
          <p>آکای تراول هي شركة سياحية إيرانية متخصصة في تقديم خدمات متكاملة للمسافرين العرب من دول الخليج العربي. تأسست الشركة في مدينة أرومية، عاصمة محافظة أذربيجان الغربية في شمال غرب إيران، لتكون جسراً بين الثقافة الإيرانية والضيف العربي.</p>
          <p>تقدم آکای تراول باقة متنوعة من الخدمات تشمل السياحة الترفيهية والثقافية في مختلف المدن الإيرانية، والسياحة العلاجية في أفضل المستشفيات والعيادات، وخدمات الاستيراد والتجارة من إيران إلى دول الخليج، بالإضافة إلى توفير الصناعات اليدوية الإيرانية الأصلية مثل السجاد الفارسي والفيروز والخاتم.</p>
          <p>يضم فريقنا مجموعة من المتخصصين الذين يتحدثون اللغة العربية ويتمتعون بخبرة واسعة في تنظيم الرحلات وخدمة الضيوف العرب. نحن نؤمن بأن كل مسافر يستحق تجربة مميزة وآمنة ومريحة، ولذلك نقدم خدمات شاملة من لحظة الحجز وحتى العودة إلى الوطن.</p>
          <p>نلتزم في آکای تراول بأعلى معايير الجودة والشفافية في التعامل، ونحرص على تقديم أسعار تنافسية وخدمات شخصية تناسب احتياجات كل عميل. هدفنا هو أن نكون شريكك الموثوق في كل رحلة إلى إيران.</p>
        </div>
      </div>
    </section>

    <section class="py-16 bg-ink-50">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink-800 mb-8 text-center">الترخيص الرسمي</h2>
        <div class="bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl p-8 border-2 border-primary-200 text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary-500 mb-4">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.062-.18-2.087-.514-3.056z" />
            </svg>
          </div>
          <p class="text-lg text-ink-700 leading-relaxed max-w-2xl mx-auto">
            شركة آکای تراول حاصلة على ترخيص رسمي من منظمة التراث الثقافي والسياحة والصناعات اليدوية في محافظة أذربيجان الغربية، الجمهورية الإسلامية الإيرانية.
          </p>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink-800 mb-8 text-center">موقعنا</h2>
        <div class="bg-ink-50 rounded-2xl p-8 border border-ink-200">
          <div class="flex items-start gap-3 mb-6">
            <svg class="w-6 h-6 text-primary-600 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <p class="text-lg text-ink-700">إيران، محافظة أذربيجان الغربية، أرومية، شارع آزادكان، شارع تيلا</p>
          </div>
          <iframe
            src="https://www.google.com/maps?q=Urmia+Azadegan+Tila&output=embed"
            width="100%"
            height="350"
            style="border:0; border-radius: 12px;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="موقع آکای تراول في أرومية"
          ></iframe>
        </div>
      </div>
    </section>

    <section class="py-16 bg-ink-50">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink-800 mb-8 text-center">خدماتنا</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {serviceCards.map((card) => (
            <a href={card.href} class="bg-white rounded-2xl p-6 card-hover border border-ink-200 block text-center group">
              <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-primary-50 mb-4 group-hover:bg-primary-100 transition-colors">
                <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={card.icon} />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-ink-800 group-hover:text-primary-600 transition-colors">{card.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink-800 mb-8 text-center">لماذا آکای تراول</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {whyUs.map((item, i) => (
            <div class="flex items-start gap-4 bg-ink-50 rounded-xl p-5 border border-ink-200">
              <div class="flex items-center justify-center w-10 h-10 rounded-full bg-secondary-500 text-white font-bold shrink-0">
                {i + 1}
              </div>
              <div>
                <h3 class="font-bold text-ink-800 mb-1">{item.title}</h3>
                <p class="text-ink-500 text-sm leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-gradient-to-l from-secondary-500 to-secondary-700 text-white">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4">تواصل معنا الآن</h2>
        <p class="text-lg text-secondary-50 mb-8">احصل على استشارة مجانية لخطط سفرك أو علاجك أو استيرادك من إيران</p>
        <a
          href="https://wa.me/989143403431"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-white text-secondary-700 font-bold px-8 py-4 rounded-xl hover:bg-secondary-50 transition-colors shadow-xl text-lg"
        >
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          تواصل عبر واتساب
        </a>
      </div>
    </section>
  </main>
</Base>
