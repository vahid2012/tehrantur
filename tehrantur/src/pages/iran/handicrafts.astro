---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import FloatingInstagram from '../../components/FloatingInstagram.astro';
import { images } from '../../data/images';

const handicraftsImg = images['handicrafts' as keyof typeof images];

const products = [
  { name: 'السجاد الفارسي الأصلي', desc: 'سجاد يدوي من أصالة إيران — من تبريز وأصفهان وقم. عقد فريد وألوان طبيعية.', img: images['persian-carpet' as keyof typeof images] },
  { name: 'الفيروز النيشابوري', desc: 'أجود أنواع الفيروز في العالم من مناجم نيشابور. خواتم وأحجار ومشغولات.', img: images['turquoise' as keyof typeof images] },
  { name: 'الفضة الأصفهانية', desc: 'مشغولات فضية يدوية من حرفيي أصفهان — إبريق وصواني ومجوهرات بنقوش فارسية.', img: images['silver' as keyof typeof images] },
  { name: 'خاتم شيراز', desc: 'فن الخاتم الإيراني العريق — صناديق وطاولات ولوحات بفصوص العظم والخشب.', img: images['khatam' as keyof typeof images] },
  { name: 'الزجاج المظلل والنحاسيات', desc: 'زجاج ملون بنقوش إسلامية ونحاسيات مطروقة يدوياً من أسواق طهران وأصفهان.', img: images['glass-copper' as keyof typeof images] },
  { name: 'السجاد القطيفي والكليم', desc: 'سجاد قطيفي وكليم قبلي بنقوش بدوية أصيلة — قطع فريدة لكل منزل.', img: images['kilim' as keyof typeof images] },
];

const priceTable = [
  { product: 'سجاد فارسي (2×3 متر)', price: '800', delivery: '7-14 يوم' },
  { product: 'خاتم صندوق (20×20 سم)', price: '150', delivery: '5-10 أيام' },
  { product: 'خاتم فيروز (فضة)', price: '60', delivery: '5-10 أيام' },
  { product: 'مشغولات فضية (إبريق)', price: '120', delivery: '7-14 يوم' },
  { product: 'زجاج مظلل (مزهرية)', price: '45', delivery: '5-10 أيام' },
  { product: 'كليم قبلي (1.5×2 متر)', price: '350', delivery: '7-14 يوم' },
];

const steps = [
  { title: 'تواصل عبر واتساب', desc: 'أرسل لنا رسالة بالمنتج الذي ترغب فيه وسنرد عليك فوراً.' },
  { title: 'اختر المنتج', desc: 'نرسل لك صور وفيديوهات للمنتجات المتوفرة لتختار ما يناسبك.' },
  { title: 'ادفع وأكد الطلب', desc: 'بعد الاتفاق على السعر، تدفع المبلغ ونؤكد الطلب ونبدأ التغليف.' },
  { title: 'الشحن إلى بلدك', desc: 'نشحن المنتج عبر شركة شحن موثوقة ونتابع حتى يصل إلى باب منزلك.' },
];

const shippingCountries = [
  { name: 'السعودية', flag: '🇸🇦' },
  { name: 'الإمارات', flag: '🇦🇪' },
  { name: 'قطر', flag: '🇶🇦' },
  { name: 'الكويت', flag: '🇰🇼' },
  { name: 'البحرين', flag: '🇧🇭' },
  { name: 'عُمان', flag: '🇴🇲' },
];

const faqs = [
  { q: 'هل السجاد الفارسي الذي تبيعونه أصلي؟', a: 'نعم، جميع منتجاتنا أصلية ومصدرها مباشرة من الحرفيين في تبريز وأصفهان وقم. نوفر شهادة أصالة مع كل قطعة سجاد.' },
  { q: 'كم تستغرق مدة التوصيل إلى دول الخليج؟', a: 'تتراوح مدة التوصيل بين 5 و14 يوم عمل حسب نوع المنتج والدولة. السجاد قد يستغرق وقتاً أطول بسبب التغليف الخاص.' },
  { q: 'كيف أدفع مقابل المنتجات؟', a: 'يمكن الدفع عبر تحويل بنكي أو حوالة عبر دول وسيطة. نقوم بتأكيد الطلب بعد استلام الدفع ونرسل لك إثبات الشحن.' },
  { q: 'هل يمكنني رؤية المنتج قبل الشراء؟', a: 'نعم، نرسل لك صور وفيديوهات للمنتج الفعلي عبر واتساب قبل تأكيد الطلب. يمكنك اختيار القطعة التي تناسبك.' },
  { q: 'ماذا لو وصل المنتج تالفاً؟', a: 'نضمن وصول المنتج بحالة جيدة عبر تغليف آمن. إذا وصل تالفاً نتيجة الشحن، نتعامل مع شركة الشحن لتعويضك أو استبدال المنتج.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'الصناعات اليدوية الإيرانية الأصلية',
  url: 'https://akay-travel.com/iran/handicrafts',
  inLanguage: 'ar',
  isPartOf: { '@type': 'WebSite', name: 'آکای تراول', url: 'https://akay-travel.com' },
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.name,
  })),
};

const productSchemas = priceTable.map((row) => ({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: row.product,
  offers: {
    '@type': 'Offer',
    price: row.price,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'آکای تراول' },
  },
}));

const relatedArticles = [
  { title: 'السياحة في إيران وأهم المعالم', href: '/iran/tourism', description: 'اكتشف معالم إيران السياحية من طهران إلى شيراز.' },
  { title: 'أسواق طهران التجارية للمستوردين العرب', href: '/iran/tehran/trade-markets', description: 'دليل أسواق طهران التجارية والتسوق.' },
  { title: 'الاستيراد من إيران دليل التجارة والشحن', href: '/iran/import-guide', description: 'دليل شامل للاستيراد من إيران.' },
];
---

<Base
  title="الصناعات اليدوية الإيرانية | سجاد وفيروز وفضة - آکای تراول"
  description="اشترِ الصناعات اليدوية الإيرانية الأصلية: سجاد فارسي، فيروز نيشابور، فضة أصفهان، خاتم شيراز. شحن لكل دول الخليج عبر آکای تراول."
  breadcrumbs={[{ name: 'إيران', href: '/iran' }, { name: 'الصناعات اليدوية', href: '/iran/handicrafts' }]}
  relatedArticles={relatedArticles}
  ogImage={handicraftsImg?.src}
>
  <Header slot="header" />
  <Footer slot="footer" />
  <FloatingWhatsApp />
  <FloatingInstagram />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  {productSchemas.map((ps) => (
    <script type="application/ld+json" set:html={JSON.stringify(ps)} />
  ))}

  <main>
    <section class="relative min-h-[400px] flex items-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src={handicraftsImg?.src} alt={handicraftsImg?.alt} class="w-full h-full object-cover" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-l from-ink-900/90 via-ink-900/70 to-ink-900/50"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 py-16 w-full">
        <div class="max-w-2xl">
          <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">الصناعات اليدوية الإيرانية الأصلية — تسوق مباشر</h1>
          <p class="text-lg text-ink-200">سجاد فارسي، فيروز نيشابور، فضة أصفهان، خاتم شيراز — شحن لكل دول الخليج.</p>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink-800 mb-6">لماذا الصناعات اليدوية الإيرانية</h2>
        <div class="prose prose-lg max-w-none text-ink-600 leading-relaxed space-y-4">
          <p>تُعد إيران من أعرق مراكز الصناعات اليدوية في العالم، حيث يمتد تاريخ الحرف الإيرانية لآلاف السنين. من سجاد تبريز وقم الذي يُعد من أفخر أنواع السجاد في العالم، إلى الفيروز النيشابوري الذي لا مثيل له في جودته، إلى الخاتم والفضة والزجاج المظلل — كل قطعة تحكي قصة حضارة وإبداع.</p>
          <p>المشكلة التي يواجهها المشتري العربي هي صعوبة الوصول إلى هذه المنتجات الأصلية بأسعار عادلة. كثير من ما يباع في الأسواق على أنه "إيراني" هو في الواقع تقليد رخيص. مع آکای تراول، تشتري مباشرة من المصدر في إيران، وتتأكد من أصالة المنتج وجودته قبل الدفع.</p>
          <p>نحن نوفر خدمة شراء وتغليف وشحن متكاملة — تختار المنتج عبر واتساب، نرسل لك صور وفيديوهات، وبعد موافقتك نقوم بالتغليف الآمن والشحن إلى بلدك. كل ذلك بأسعار أقل بكثير من ما تجده في الأسواق المحلية.</p>
        </div>
      </div>
    </section>

    <section class="py-16 bg-ink-50">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink-800 mb-8 text-center">منتجاتنا</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {products.map((product) => (
            <div class="bg-white rounded-2xl overflow-hidden card-hover border border-ink-200">
              <div class="relative h-56 overflow-hidden">
                <img src={product.img?.src} alt={product.img?.alt} loading="lazy" class="w-full h-full object-cover" />
              </div>
              <div class="p-5">
                <h3 class="text-lg font-bold text-ink-800 mb-2">{product.name}</h3>
                <p class="text-ink-500 text-sm leading-relaxed mb-4">{product.desc}</p>
                <a
                  href="https://wa.me/989143403431"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 bg-secondary-500 hover:bg-secondary-600 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                  </svg>
                  اطلب الآن
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink-800 mb-8 text-center">الأسعار التقديرية</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-right border-collapse">
            <thead>
              <tr class="bg-ink-800 text-white">
                <th class="py-3 px-4 font-bold">المنتج</th>
                <th class="py-3 px-4 font-bold">السعر من (USD)</th>
                <th class="py-3 px-4 font-bold">مدة التوصيل</th>
              </tr>
            </thead>
            <tbody>
              {priceTable.map((row) => (
                <tr class="border-b border-ink-200 hover:bg-ink-50 transition-colors">
                  <td class="py-3 px-4 text-ink-700 font-medium">{row.product}</td>
                  <td class="py-3 px-4 text-primary-600 font-bold">${row.price}</td>
                  <td class="py-3 px-4 text-ink-500">{row.delivery}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-sm text-ink-400 mt-4 text-center">الأسعار تقديرية وقابلة للتفاوض حسب نوع وجودة القطعة.</p>
      </div>
    </section>

    <section class="py-16 bg-ink-50">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink-800 mb-8 text-center">كيف تطلب</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {steps.map((step, i) => (
            <div class="bg-white rounded-2xl p-6 border border-ink-200 flex items-start gap-4">
              <div class="flex items-center justify-center w-12 h-12 rounded-full bg-primary-500 text-white font-bold text-lg shrink-0">
                {i + 1}
              </div>
              <div>
                <h3 class="font-bold text-ink-800 mb-1">{step.title}</h3>
                <p class="text-ink-500 text-sm leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink-800 mb-8 text-center">الشحن والدفع</h2>
        <p class="text-ink-500 text-center mb-6">نشحن إلى جميع دول الخليج العربي:</p>
        <div class="flex flex-wrap justify-center gap-3 mb-8">
          {shippingCountries.map((country) => (
            <div class="bg-ink-50 rounded-xl px-5 py-3 border border-ink-200 flex items-center gap-2">
              <span class="text-2xl">{country.flag}</span>
              <span class="font-medium text-ink-700">{country.name}</span>
            </div>
          ))}
        </div>
        <div class="bg-ink-50 rounded-2xl p-6 border border-ink-200 max-w-2xl mx-auto">
          <h3 class="font-bold text-ink-800 mb-3">طرق الدفع:</h3>
          <ul class="space-y-2 text-ink-600">
            <li class="flex items-center gap-2"><span class="text-secondary-500">✓</span> تحويل بنكي دولي</li>
            <li class="flex items-center gap-2"><span class="text-secondary-500">✓</span> حوالة عبر دول وسيطة (الإمارات، تركيا)</li>
            <li class="flex items-center gap-2"><span class="text-secondary-500">✓</span> الدفع نقداً عند الاستلام في بعض الحالات</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="py-16 bg-ink-50">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink-800 mb-8 text-center">الأسئلة الشائعة</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="bg-white rounded-xl p-5 border border-ink-200 group">
              <summary class="font-bold text-ink-800 cursor-pointer flex items-center justify-between list-none">
                {faq.q}
                <svg class="w-5 h-5 text-primary-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="mt-3 text-ink-500 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-gradient-to-l from-primary-600 to-primary-800 text-white">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4">أرغب في طلب صناعات يدوية إيرانية</h2>
        <p class="text-lg text-primary-100 mb-8">تواصل معنا الآن وأخبرنا بالمنتج الذي تريده وسنرسل لك التفاصيل والأسعار</p>
        <a
          href="https://wa.me/989143403431?text=أرغب%20في%20طلب%20صناعات%20يدوية%20إيرانية"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-white text-primary-700 font-bold px-8 py-4 rounded-xl hover:bg-primary-50 transition-colors shadow-xl text-lg"
        >
          <svg class="w-7 h-7 text-secondary-500" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          تواصل عبر واتساب
        </a>
      </div>
    </section>
  </main>
</Base>
