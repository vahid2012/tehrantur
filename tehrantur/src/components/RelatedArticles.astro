---
export interface Props {
  articles: Array<{ title: string; href: string; description?: string }>;
  title?: string;
}

const { articles, title = 'مقالات ذات صلة' } = Astro.props;
---

{articles.length > 0 && (
  <section class="bg-ink-100 py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-ink-800 mb-8 text-center">{title}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {articles.map((article) => (
          <a
            href={article.href}
            class="bg-white rounded-2xl p-6 card-hover border border-ink-200 block group"
          >
            <div class="w-12 h-12 rounded-xl bg-primary-50 flex items-center justify-center mb-4 group-hover:bg-primary-100 transition-colors">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-ink-800 mb-2 group-hover:text-primary-600 transition-colors">
              {article.title}
            </h3>
            {article.description && (
              <p class="text-ink-500 text-sm leading-relaxed">{article.description}</p>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>
)}
